# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in the Vercel project dashboard for
# production. Never commit the real .env.local — it's git-ignored.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the legacy `anon` JWT or the newer `sb_publishable_…` key works here.
# Both are public by design. NEVER put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, never exposed to the browser. Used by the
# M-Pesa callback webhook and admin actions (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- M-Pesa Daraja (required for real payments) -----------------------------
# Register an app at https://developer.safaricom.co.ke to get sandbox
# credentials; production requires an approved Paybill/Till.
# Until these are set, /api/mpesa/stkpush returns a clear "not configured"
# error instead of a fake success.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# A long random secret only you and Safaricom know — generate with:
#   openssl rand -hex 32
# This guards the callback URL below (Daraja doesn't sign callbacks, so
# without this, anyone who learns a transaction's checkoutRequestId — which
# is legitimately returned to the paying student's browser — could forge a
# fake "payment successful" callback). See app/api/mpesa/callback/[secret]/route.ts.
MPESA_CALLBACK_SECRET=
# Must be a public HTTPS URL Safaricom can reach, ending in the exact secret
# above, e.g. https://your-app.vercel.app/api/mpesa/callback/<MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
