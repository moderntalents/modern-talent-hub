# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in the Vercel project dashboard for
# production. Never commit the real .env.local — it's git-ignored.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the legacy `anon` JWT or the newer `sb_publishable_…` key works here.
# Both are public by design. NEVER put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, never exposed to the browser. Used by the
# M-Pesa callback webhook and admin actions (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Registration verification email (required for signup) -------------------
# Registration sends a 5-digit code by email (lib/verification.ts). Until these
# are set, signup shows "Email verification isn't set up yet" — it never
# pretends an email was sent.
# Gmail: turn on 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
# Use that here — NOT your normal Gmail password.
SMTP_USER=yourname@gmail.com
SMTP_PASS=
# Optional; these defaults are for Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="Modern Talent Hub <yourname@gmail.com>"
# 32+ random characters that key the stored code hashes — generate with:
#   openssl rand -hex 32
# Changing it invalidates any codes that are currently pending (10-minute life).
VERIFICATION_CODE_SECRET=

# --- Live classes (video) ------------------------------------------------------
# Live lessons/activities use Daily (https://www.daily.co) for the video room —
# see lib/live/daily.ts. Create a free account, then:
#   DAILY_API_KEY  = Dashboard -> Developers -> API keys (secret; server-only)
#   DAILY_DOMAIN   = your subdomain only, e.g. "modern-talent" for modern-talent.daily.co
# Until both are set, teachers can still SCHEDULE live classes but pressing
# Start says live video isn't set up — it never pretends a class started.
DAILY_API_KEY=
DAILY_DOMAIN=

# --- Password reset links -----------------------------------------------------
# Emailed reset links are always built from this public address — never from the
# request's own origin — so they can't point at a *.vercel.app preview URL. The
# app refuses to start a reset if this is a *.vercel.app address. Optional: it
# defaults to https://rutechbranding.ink. Password reset sends through the
# same SMTP_USER / SMTP_PASS mailbox as registration above.
# NEXT_PUBLIC_SITE_URL=https://rutechbranding.ink

# --- M-Pesa Daraja (required for real payments) -----------------------------
# Register an app at https://developer.safaricom.co.ke to get sandbox
# credentials; production requires an approved Paybill/Till.
# Until these are set, /api/mpesa/stkpush returns a clear "not configured"
# error instead of a fake success.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# A long random secret only you and Safaricom know — generate with:
#   openssl rand -hex 32
# This guards the callback URL below (Daraja doesn't sign callbacks, so
# without this, anyone who learns a transaction's checkoutRequestId — which
# is legitimately returned to the paying student's browser — could forge a
# fake "payment successful" callback). See app/api/mpesa/callback/[secret]/route.ts.
MPESA_CALLBACK_SECRET=
# Must be a public HTTPS URL Safaricom can reach, ending in the exact secret
# above, e.g. https://your-app.vercel.app/api/mpesa/callback/<MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
